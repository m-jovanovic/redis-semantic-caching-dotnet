# Optional. Copy to .env (git ignores it) and replace the PASTE_ values.
# A value that still contains PASTE_ is ignored, so the app keeps using local Redis.

# Redis Cloud
Demo__RedisConnection=PASTE_HOST:PASTE_PORT,user=default,password=PASTE_REDIS_PASSWORD,abortConnect=false,protocol=resp2

# Agent Playbooks: the key needs the read and propose actions, nothing more.
AgentPlaybook__EndpointUrl=PASTE_ENDPOINT
AgentPlaybook__PlaybookId=PASTE_PLAYBOOK_ID
AgentPlaybook__ApiKey=PASTE_PLAYBOOK_KEY
